# Base URL of the API. Leave as-is for local development.
VITE_API_URL=http://localhost:5000/api/v1

# Supabase project — Dashboard → Project Settings → API.
# The anon key is public by design and safe to ship in the bundle.
# NEVER put the service_role key here: it bypasses all access control.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
