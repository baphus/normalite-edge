NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase Postgres (Dashboard → Project Settings → Database)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Supabase Auth (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key — bypasses row-level security and can provision or delete
# any identity. Server-only. Never expose it to the browser, never commit it,
# and rotate it if it is ever printed to a log.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (profile pictures and question images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
